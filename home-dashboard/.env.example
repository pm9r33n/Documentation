# Copy to .env (git-ignored) or export in the process manager. Never commit a token.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# e.g. notify.mobile_app_pauls_iphone (required for live mode)
HA_NOTIFY_SERVICE=
# Default: data/engine-state.json
HOME_DASHBOARD_STATE_FILE=
# Leave unset for observe-only. Set to 1 to allow real actions and notifications.
HOME_DASHBOARD_LIVE=
